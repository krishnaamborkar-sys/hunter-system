# Optional OpenAI-compatible API settings.
# Keep real values in the Pydroid shell/environment or a PRIVATE local .env file.
# NEVER commit a real .env file, paste a key into index.html, or share a key in chat.
# The local backend works without these values, but then it uses a command helper
# rather than a generative AI model.
SYSTEM_AI_API_BASE=https://your-provider.example/v1
SYSTEM_AI_API_KEY=replace-with-your-own-secret
SYSTEM_AI_MODEL=replace-with-a-model-name
SYSTEM_AI_PORT=8765
